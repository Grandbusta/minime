# `go run ./cmd/minime new` writes .env for you. Never commit it.
#
# Everything about a person is in their own database: their life, how they
# live, their skills and their keys (bot token, OpenAI key, ...). .env only
# says where that database is, and holds the key that opens their secrets.

# Their Postgres, password included. One database per person.
DATABASE_URL=postgres://user:password@host:5432/minime?sslmode=require

# Opens their secrets, which are sealed in their database with it: 64 hex
# characters (openssl rand -hex 32). Keep it with DATABASE_URL, and safe:
# without it their secrets can't be read (minime secret set them again).
MINIME_KEY=
