# `go run ./cmd/minime new` writes .env for you. Or copy this to .env and fill
# it in. Never commit .env.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (`minime new` finds it for you): message your
# bot, then open https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates.
TELEGRAM_OWNER_ID=

# Connection string of the managed Postgres, password included.
DATABASE_URL=postgres://user:password@host:5432/minime?sslmode=require

# Used by System 1 (OpenAI Decisions API) and System 2 (OpenAI Responses API).
OPENAI_API_KEY=
# The model System 2 reasons with, e.g. gpt-6-luna.
OPENAI_MODEL=

# Mind console token. Not needed on localhost; required when console.addr is
# reachable from elsewhere (16+ characters), e.g. openssl rand -hex 24.
CONSOLE_TOKEN=
